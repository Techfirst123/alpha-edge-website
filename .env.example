# --- MongoDB Atlas -----------------------------------------------------
# Connection string (Atlas dashboard: Database > Connect > Drivers).
# Server-side only — never prefix this with VITE_, or it would be bundled
# into the public browser build. In Atlas, Network Access must allow
# 0.0.0.0/0 (Cloudflare Workers don't have static outbound IPs) — see
# README.md for why that's safe here (auth is still required at the DB
# user level).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional — database name to use (defaults to "alphaedge" if unset).
MONGODB_DB=alphaedge

# --- Admin auth ----------------------------------------------------------
# Bootstrap Super Admin (/login) — used exactly once: the first time anyone
# logs in against an empty `admins` collection, this account is created as
# the initial Super Admin (password hashed, never stored in plain text).
# After that, manage admins from the dashboard's "Manage Admin" panel — these
# two values are no longer read. Generate the secret once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=<random-hex-string>

# Leave unset (or "production") for real deployments — only set this to
# "development" in your local .dev.vars file, so the admin session cookie
# doesn't require HTTPS while testing with `wrangler pages dev` locally.
ENVIRONMENT=production

# --- Contact form email (functions/api/contact.js, via Resend) ----------
RESEND_API_KEY=<resend-api-key>
CONTACT_FROM_EMAIL="Alpha Edge Website <enquiries@alphaedgeitservices.co.uk>"
CONTACT_TO_EMAIL=info@alphaedgeitservices.co.uk

# --- Image uploads ---------------------------------------------------
# No env var needed here — admin-uploaded photos are stored in the
# UPLOADS_BUCKET R2 bucket, configured as a binding in wrangler.toml (and
# added again in the Cloudflare Pages dashboard under Settings -> Functions
# -> R2 bucket bindings for the deployed site). Only the resulting
# /uploads/... URL is stored in MongoDB.
